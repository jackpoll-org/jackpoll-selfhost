# Jackpoll — single-host self-host configuration.
#
# Copy this file to `.env` and replace every CHANGE_ME with a strong, unique
# value. These are read by docker-compose.simple.yml.
#
#   cp .env.simple.example .env
#   docker compose -f docker-compose.simple.yml up -d
#
# NEVER commit the filled-in .env — it holds production secrets.

# ── Images (pin to a release tag instead of :latest for reproducible deploys) ──
FRONTEND_IMAGE=ghcr.io/jackpoll-org/frontend:latest
BACKEND_IMAGE=ghcr.io/jackpoll-org/backend:latest

# ── Published host ports ──────────────────────────────────────────────────────
FRONTEND_PORT=3000
BACKEND_PORT=8080
KEYCLOAK_PORT=8180
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MAILPIT_UI_PORT=8025

# ── Public URLs ───────────────────────────────────────────────────────────────
# For a localhost trial the defaults work. For a real deployment set these to
# your domain (and put a reverse proxy with TLS in front — see the Swarm stack).
APP_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
KEYCLOAK_HOSTNAME=http://localhost:8180

# ── Database ──────────────────────────────────────────────────────────────────
DB_NAME=survey
DB_USERNAME=survey
DB_PASSWORD=CHANGE_ME_db_password

# ── Object storage (MinIO / S3) ───────────────────────────────────────────────
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=CHANGE_ME_minio_secret
MINIO_BUCKET=survey

# ── Keycloak (auth) ───────────────────────────────────────────────────────────
KEYCLOAK_REALM=survey-school
KEYCLOAK_CLIENT_ID=survey-backend
KEYCLOAK_CLIENT_SECRET=CHANGE_ME_keycloak_client_secret
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_keycloak_admin_password

# ── Spam / bot protection (HMAC secret; use a long random value) ──────────────
SURVEY_SPAM_SECRET=CHANGE_ME_long_random_spam_secret

# ── Email verification / password reset (HMAC secret signing the at-rest code
# hash; use a long random value) ───────────────────────────────────────────────
EMAIL_CODE_SECRET=CHANGE_ME_long_random_email_code_secret

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_BACKEND=redis

# ── Email ─────────────────────────────────────────────────────────────────────
# Default: bundled Mailpit (nothing leaves the host; view at :8025). For real
# delivery, point these at your SMTP server.
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_TLS=DISABLED
MAIL_FROM=Jackpoll <noreply@localhost>

# ── Optional: upload virus scanning (needs a clamav service; off here) ────────
CLAMAV_ENABLED=false

# ── Push notifications (UnifiedPush via bundled ntfy) ─────────────────────────
# The app receives push through this ntfy server. Locally it's reachable at the
# port below; for a public instance put it behind TLS and set NTFY_BASE_URL to
# the public https URL, then use that as the push distributor in the app.
NTFY_PORT=8090
NTFY_BASE_URL=http://localhost:8090
