# Example environment for the Docker Swarm stack (docker-compose.swarm.yml).
#
# Copy to .env.swarm, fill in real secrets, then load before deploying:
#   cp .env.swarm.example .env.swarm
#   set -a; . ./.env.swarm; set +a
#   docker stack deploy -c docker-compose.swarm.yml survey
#
# NOTE: `docker stack deploy` does NOT read this file automatically — it only
# interpolates variables already present in the shell environment.

# ── Images (pushed by the Publish image workflow) ───────────────────
BACKEND_IMAGE=ghcr.io/madebyleopold/survey-backend:latest
FRONTEND_IMAGE=ghcr.io/madebyleopold/survey-frontend:latest
# Only used by the all-in-one docker-compose.swarm.yml (which bundles the landing).
LANDING_IMAGE=ghcr.io/jackpoll-org/jackpoll-landing:latest

# ── Scaling & routing ───────────────────────────────────────────────
# Routing is via an existing Traefik on the external `traefik` network — no
# service publishes a host port. Create the network once if needed:
#   docker network create --driver overlay --attachable traefik
BACKEND_REPLICAS=2
FRONTEND_REPLICAS=2
LANDING_REPLICAS=2
# Public hostname Traefik routes to the frontend (TLS via the le-prod resolver).
FRONTEND_HOST=survey.quavon.de
# Apex hostname for the bundled landing page (all-in-one stack only).
LANDING_HOST=jackpoll.org

# ── Public URLs ─────────────────────────────────────────────────────
# Where browsers reach the app; used for CORS and links in emails.
APP_BASE_URL=https://survey.quavon.de
CORS_ORIGINS=https://survey.quavon.de

# ── Database (use Docker secrets in production) ─────────────────────
DB_NAME=survey
DB_USERNAME=survey
DB_PASSWORD=change-me-db-password
# Schema is Flyway-managed (issue #41): migrations run at startup, Hibernate
# validates. No DB_GENERATION needed.

# ── Object storage (MinIO) ──────────────────────────────────────────
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-me-minio-secret
MINIO_BUCKET=survey-uploads

# ── Keycloak (OIDC) ─────────────────────────────────────────────────
# In production this must be the PUBLIC issuer URL the browser uses, so token
# issuers validate. For the single-node example the internal name is fine.
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=survey-school
KEYCLOAK_CLIENT_ID=survey-backend
KEYCLOAK_CLIENT_SECRET=change-me-client-secret
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-admin-password

# ── Email ───────────────────────────────────────────────────────────
# Example uses the bundled Mailpit; point at a real SMTP server in production.
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM=Survey School <noreply@surveyschool.test>
# Email verification & password-reset codes are sent via the SMTP server above
# (not Keycloak SMTP). Sign the at-rest code hash with a strong random secret:
#   openssl rand -hex 32
EMAIL_CODE_SECRET=change-me-email-code-secret

# ── App secrets ─────────────────────────────────────────────────────
SURVEY_SPAM_SECRET=change-me-spam-secret

# ── Open-source Supporters (Mollie) ─────────────────────────────────
# The only payment surface (Jackpoll is free). MOLLIE_API_KEY is server-only.
# LANDING_BASE_URL is where Mollie sends supporters back after paying.
# PUBLIC_API_URL is the backend's public URL for the Mollie webhook (recurring
# subscriptions need it). In the all-in-one stack the bundled landing reaches the
# API internally, so BACKEND_API_URL defaults to http://backend:8080 (only set it
# when the landing runs on its own).
MOLLIE_API_KEY=
LANDING_BASE_URL=https://jackpoll.org
PUBLIC_API_URL=https://api.jackpoll.org

# ── Rate limiting (issue #42) ───────────────────────────────────────
# "redis" shares the limit across backend replicas (recommended for >1).
RATE_LIMIT_BACKEND=redis
REDIS_URL=redis://redis:6379

# ── Upload virus scanning (issue #43) ───────────────────────────────
# Enable to route uploads through the clamav service before storing them.
CLAMAV_ENABLED=false
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_FAIL_OPEN=false

# ── Web Push for browsers / PWA (issue #74) ─────────────────────────
# Generate a VAPID key pair once: `npx web-push generate-vapid-keys`.
# Web Push activates as soon as both keys are set (no PUSH_ENABLED needed).
# The private key is sensitive — keep it out of version control.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@quavon.de

# ── Native push notifications (issue #46) ───────────────────────────
# FCM HTTP v1 for the mobile apps. Needs a Firebase service account.
PUSH_ENABLED=false
FCM_SERVICE_ACCOUNT=
